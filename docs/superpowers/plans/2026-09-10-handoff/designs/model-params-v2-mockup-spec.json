{
  "title": "ask-your-docs Connection dialog - Model settings (v2 final)",
  "source_design": "ayd-params-v2/PROPOSAL.md - one Thinking control mapped per provider + Temperature + Max output tokens; Top p and Seed under More; controls the model/provider cannot honour are hidden entirely (no disabled rows, no captions)",
  "shared": {
    "section_order": ["thinking", "temperature", "max_tokens", "more"],
    "controls": {
      "thinking": {"label": "Thinking", "widget": "st.segmented_control", "key": "connection_param_thinking",
                   "all_options": ["Auto", "Off", "Low", "Medium", "High"],
                   "on_off_family_options": ["Auto", "Off", "On"],
                   "stored": {"Auto": null, "Off": "off", "Low": "low", "Medium": "medium", "High": "high", "On": "medium"},
                   "wire_phase1": {"Auto": {}, "Off": {"reasoning_effort": "none"}, "Low": {"reasoning_effort": "low"},
                                   "Medium": {"reasoning_effort": "medium"}, "High": {"reasoning_effort": "high"}, "On": {"reasoning_effort": "medium"}},
                   "wire_phase2": {
                     "openrouter": {"Off": {"extra_body": {"reasoning": {"enabled": false}}}, "Low|Medium|High": {"extra_body": {"reasoning": {"effort": "<x>"}}}, "note": "replaces top-level reasoning_effort"},
                     "vllm_declared": {"Off": {"reasoning_effort": "none", "extra_body": {"chat_template_kwargs": {"enable_thinking": false}}}},
                     "openai|litellm|generic": "unchanged from phase 1"}},
      "temperature": {"label": "Temperature", "widget": "st.number_input", "key": "connection_param_temperature", "blank": "model default (not sent)", "min": 0, "max": 2, "step": 0.05},
      "max_tokens": {"label": "Max output tokens", "widget": "st.number_input", "key": "connection_param_max_tokens", "blank": "model default (not sent)", "min": 1, "max": "known ceiling or none", "wire_name": "max_completion_tokens"},
      "top_p": {"label": "Top p", "widget": "st.number_input", "key": "connection_param_top_p", "under": "More", "min_exclusive": 0, "max": 1},
      "seed": {"label": "Seed", "widget": "st.number_input", "key": "connection_param_seed", "under": "More", "min": 0},
      "more_buttons": {"use_yaml": "Use YAML settings", "restore_hidden": "Restore hidden settings (N) - shown only after a learned rejection"}
    },
    "rules": [
      "Hidden controls are not rendered at all: no disabled rows, no captions",
      "Blank field / Auto = not sent (model default); placeholders show known defaults only",
      "Options are intersected with provider metadata, never coerced",
      "Saved values for hidden controls are not sent; the Test line lists exactly what is sent; a JSON log records the drop",
      "The status line under the model picker is the only standing text: '<N> models listed · vision: ... · <provider>'; generic adds 'settings unverified'",
      "More is not rendered when it would be empty"
    ]
  },
  "states": [
    {
      "id": "A_openrouter",
      "label": "OpenRouter · qwen/qwen3.8-27b (efforts xhigh/medium/low, not mandatory)",
      "base_url": "https://openrouter.ai/api/v1",
      "auth_caption": "$OPENROUTER_API_KEY set",
      "model": "qwen/qwen3.8-27b",
      "profile": {"wire": "openrouter", "display": "openrouter", "source": "listing"},
      "status_line": "436 models listed · vision: no (listing) · OpenRouter",
      "controls_shown": [
        {"control": "thinking", "options": ["Auto", "Low", "Medium"], "value": "Low"},
        {"control": "temperature", "value": 0.2, "placeholder": "1"},
        {"control": "max_tokens", "value": 4096},
        {"control": "more", "collapsed": true, "contains": [{"control": "top_p", "value": null, "placeholder": "0.95"}, {"control": "seed", "value": null}]}
      ],
      "hidden": ["thinking:Off (P1: 'none' not in supported_efforts)", "thinking:High (not in supported_efforts)"],
      "sends": {"reasoning_effort": "low", "temperature": 0.2, "max_completion_tokens": 4096},
      "test_line": "test passed · sent reasoning_effort=low, temperature=0.2, max_completion_tokens=4096",
      "phase2_delta": "Thinking gains Off (sent as extra_body.reasoning={enabled:false}); efforts sent as extra_body.reasoning.effort",
      "ascii": [
