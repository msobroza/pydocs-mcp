        "| 436 models listed · vision: no (listing) · OpenRouter          |",
        "|                                                                |",
        "| Thinking            Auto  [Low]  Medium                        |",
        "| Temperature         [0.2          ]                            |",
        "| Max output tokens   [4096         ]                            |",
        "| > More                                                         |",
        "|                                                                |",
        "| [Test connection]  test passed · sent reasoning_effort=low,    |",
        "|                    temperature=0.2, max_completion_tokens=4096 |",
        "|                                                     [Apply]    |",
        "+----------------------------------------------------------------+"
