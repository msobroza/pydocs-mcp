{
  "title": "ask-your-docs Connection dialog - Model settings (v2, plain-language presets)",
  "source_design": "v2: three preset controls + one collapsed Advanced; provider profiles openrouter|openai|vllm|litellm|generic; metadata only hides controls, never rewrites values",
  "shared": {
    "controls": {
      "style":    {"label": "Response style", "options": ["Precise", "Balanced", "Creative"], "default_when_absent": "Balanced", "widget": "st.segmented_control", "key": "connection_param_style"},
      "thinking": {"label": "Thinking", "options_superset": ["Auto", "Off", "On", "Low", "Medium", "High"], "default_when_absent": "Auto", "widget": "st.segmented_control", "key": "connection_param_thinking",
                    "rule": "On appears only for on/off-only model families (then Low/Medium/High are absent); Low/Medium/High appear only for graded families (then On is absent)"},
      "length":   {"label": "Answer length", "options": ["Short", "Normal", "Long"], "default_when_absent": "Normal", "widget": "st.segmented_control", "key": "connection_param_length"}
    },
    "advanced": {"label": "Advanced", "collapsed": true, "fields": ["temperature", "top_p", "max_tokens", "seed"],
                 "extras": ["sends: <wire summary line>", "button: Use YAML settings"]},
    "rules": [
      "At most three controls; a control (or option) the model cannot honour is absent, with one sentence saying why",
      "Balanced / Auto / Normal send nothing (provider or model default); byte-identical call when nothing is set",
      "Listing metadata and learned rejections only HIDE controls; they never change the value sent",
      "Advanced raw values replace the preset for the same wire field (style shows no selection, caption 'custom')",
      "Test connection sends exactly what Apply would send"
    ],
    "presets": {
      "style_temperature": {"precise": 0.2, "balanced": null, "creative": 1.0},
      "length_answer_tokens": {"short": 1024, "normal": null, "long": 16384},
      "thinking_headroom_tokens": {"off": 0, "low": 2048, "medium": 4096, "on": 4096, "auto_on_thinking_model": 4096, "high": 8192},
      "wire_max_tokens": "answer_tokens + headroom(effective thinking); sent as max_completion_tokens"
    }
  },
  "states": [
    {
      "id": "V2_A_openrouter_qwen",
      "label": "OpenRouter, qwen/qwen3.8-27b (phase 1, before R1 ratification)",
      "provider": "openrouter (host)",
      "support_source": "listing: supported_parameters + reasoning.supported_efforts [xhigh, medium, low], mandatory false",
      "selected": {"style": "Precise", "thinking": "Low", "length": "Short"},
      "sends": "temperature 0.2 · reasoning_effort low · max_completion_tokens 3072",
      "absent_sentence": "Off and High aren't offered by this model.",
      "with_R1": "Off appears; sends extra_body reasoning {enabled: false}",
      "ascii": [
        "+ Connection ------------------------------------------------------+",
        "| Base URL  [https://openrouter.ai/api/v1                       ]  |",
        "| Auth      $OPENROUTER_API_KEY set                                |",
        "| Model     [qwen/qwen3.8-27b                               v] [R] |",
        "| 436 models · vision: no (listing) · OpenRouter                   |",
        "|                                                                  |",
        "| Response style  [Precise] Balanced  Creative                     |",
        "| Thinking         Auto    [Low]  Medium                           |",
        "|   Off and High aren't offered by this model.                     |",
        "| Answer length   [Short]  Normal  Long                            |",
        "| > Advanced                                                       |",
        "|                                                                  |",
        "| [Test connection]  test passed: OK                               |",
        "|                                                        [Apply]   |",
        "+------------------------------------------------------------------+"
      ]
    },
    {
