# Bench VM image, CPU flavour: bench-cpu:<commit>.
#
# Build context: a `git archive` of ONE commit, extracted (never a working
# tree), with THIS recipe from that same commit. Cloud Build builds it through
# infra/bench-vm/cloudbuild.yaml; build-local.sh does the same with a local
# Docker. Required build arg: COMMIT (the full 40-hex SHA).
#
# The image holds the repository at /opt/pydocs-mcp, the product installed
# from source with its Rust extension built (a wheel, as shipped), the eval
# suite with [all], the dependency set from uv.lock (hash-checked, nothing
# resolved), the Cloud SDK, git, the claude CLI, and the commit in
# PYDOCS_EVAL_COMMIT_SHA. Two stages: the Rust toolchain stays in `builder`.
#
# No CUDA library: the CPU flavour installs the product with [graph] only and
# leaves the torch-backed extras ([sentence-transformers], [late-interaction])
# to Dockerfile.cuda, because on Linux uv.lock pins torch as a CUDA 13 build
# with its nvidia-* wheels. A config whose embedder provider is
# sentence_transformers, or which enables late_interaction, needs bench-cuda.
# Keep this file and Dockerfile.cuda in step: they differ only where marked.

ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490
ARG RUST_IMAGE=rust:1.99.1-slim-bookworm@sha256:f2c004e3d2d8b547e8cf7ffbc29205385f4e71d23e53e4e383065db5e9f822cd
# FLAVOUR-SPECIFIC: the runtime base.
ARG RUNTIME_IMAGE=ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852

FROM ${UV_IMAGE} AS uv

FROM ${RUST_IMAGE} AS builder
ARG PYTHON_VERSION=3.11.18
COPY --from=uv /uv /usr/local/bin/uv
# The interpreter and the venv live at the paths the final stage copies them
# to, so the venv's interpreter link and the eval suite's editable path hold.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_NO_CACHE=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
RUN uv python install "${PYTHON_VERSION}" \
 && uv venv /opt/venv --python "${PYTHON_VERSION}"
WORKDIR /opt/pydocs-mcp

# Third-party dependencies from the manifests alone: this layer is reused by
# every commit that leaves them unchanged.
COPY pyproject.toml uv.lock ./
COPY benchmarks/pyproject.toml benchmarks/
COPY infra/bench-vm/docker/ infra/bench-vm/docker/
# FLAVOUR-SPECIFIC: --flavour.
RUN python infra/bench-vm/docker/image_deps.py install --flavour cpu --repo .

# The product as a wheel (maturin builds the Rust extension, Cargo.lock
# honoured), the eval suite editable from the in-image repository, exactly as
# the CI benchmark job installs it. Build backends come from build-constraints.txt.
COPY . .
ENV CARGO_TARGET_DIR=/tmp/cargo-target \
    MATURIN_PEP517_ARGS=--locked
# FLAVOUR-SPECIFIC: --flavour.
RUN uv build --wheel --out-dir /tmp/dist --require-hashes \
      --build-constraint infra/bench-vm/docker/build-constraints.txt . \
 && uv pip install --no-config --no-deps /tmp/dist/pydocs_mcp-*.whl \
 && uv pip install --no-config --no-deps --editable benchmarks \
      --build-constraint infra/bench-vm/docker/build-constraints.txt \
 && python infra/bench-vm/docker/image_deps.py check --flavour cpu \
 && rm -rf /tmp/dist /tmp/cargo-target

FROM ${RUNTIME_IMAGE}
COPY infra/bench-vm/docker/install_system_packages.sh infra/bench-vm/docker/install_cli_tools.sh /tmp/bench-setup/
RUN bash /tmp/bench-setup/install_system_packages.sh \
 && bash /tmp/bench-setup/install_cli_tools.sh \
 && rm -rf /tmp/bench-setup
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=builder /opt/uv-python /opt/uv-python
COPY --from=builder /opt/venv /opt/venv
COPY . /opt/pydocs-mcp
WORKDIR /opt/pydocs-mcp

# WHY LD_PRELOAD: the CI benchmark job's CBLAS fix (.github/workflows/benchmark.yml),
# set image-wide so every process the supervisor starts resolves turbovec's
# cblas_sgemm from the pthread OpenBLAS at dlopen() time.
# FLAVOUR-SPECIFIC: BENCH_IMAGE_FLAVOUR.
ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/opt/google-cloud-sdk/bin:$PATH \
    UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON_PREFERENCE=only-managed \
    LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libopenblas.so.0 \
    BENCH_IMAGE_FLAVOUR=cpu \
    CLOUDSDK_CORE_DISABLE_PROMPTS=1 \
    DISABLE_AUTOUPDATER=1 \
    PYTHONUNBUFFERED=1

# Declared last on purpose: COMMIT changes with every build, and every layer
# after an ARG whose value changed misses the cache.
ARG COMMIT
RUN case "${COMMIT}" in (*[!0-9a-f]*) false ;; esac && [ "${#COMMIT}" -eq 40 ] \
 || { echo "COMMIT must be a full 40-hex commit SHA, got '${COMMIT}'" >&2; exit 1; }
# The variable the run tags fall back to without .git (pydocs_eval.sweep_support).
ENV PYDOCS_EVAL_COMMIT_SHA=${COMMIT}
LABEL org.opencontainers.image.revision=${COMMIT} \
      org.opencontainers.image.source=https://github.com/msobroza/pydocs-mcp \
      dev.pydocs-mcp.bench-vm.flavour=cpu
